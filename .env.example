# Copiar como .env (no se sube al repo) y completar.
# JWT_SECRET debe ser el mismo para los 3 microservicios (base64 de 32 bytes).
JWT_SECRET=tu_clave_base64_real
DB_PASSWORD=una_clave_para_mysql
ADMIN_PASSWORD=UnaClaveNuevaQueSoloTuSepas1
# Puerto donde queda la tienda (8080 para no chocar con Apache de XAMPP)
FRONT_PORT=8080
